# Database
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASS=postgres
DB_NAME=CremaCRM

# Redis (local Docker infrastructure)
REDIS_HOST=localhost
REDIS_PORT=6380

# Optional: setting this takes precedence over REDIS_HOST/REDIS_PORT.
# UPSTASH_REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_HOST.upstash.io:6379

# LLM
LLM_PROVIDER=gemini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Services
CRM_API_URL=http://localhost:3000
CHANNEL_STUB_URL=http://localhost:3001

# CORS
FRONTEND_URL=http://localhost:3002
